---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort();
const locations = [...new Set(jobs.map((job) => job.location))].sort();
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <form class="mb-6 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/50 p-4 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto] lg:items-end" aria-label="Filter open roles">
          <div>
            <label for="department-filter" class="mb-2 block text-sm font-medium text-slate-200">
              Department
            </label>
            <select
              id="department-filter"
              data-testid="department-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              <option value="">All departments</option>
              {departments.map((department) => <option value={department}>{department}</option>)}
            </select>
          </div>
          <div>
            <label for="location-filter" class="mb-2 block text-sm font-medium text-slate-200">
              Location
            </label>
            <select
              id="location-filter"
              data-testid="location-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              <option value="">All locations</option>
              {locations.map((location) => <option value={location}>{location}</option>)}
            </select>
          </div>
          <button
            type="reset"
            data-testid="filter-reset"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-100 hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
          >
            Reset filters
          </button>
        </form>

        <p class="mb-4 text-sm text-slate-400" data-testid="role-count" role="status" aria-live="polite">
          Showing {jobs.length} of {jobs.length} roles
        </p>
        <EmptyState
          hidden={true}
          text="No roles match these filters. Try changing or resetting your filters."
        />
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          data-testid="roles-grid"
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';

  const departmentFilter = document.querySelector<HTMLSelectElement>('[data-testid="department-filter"]');
  const locationFilter = document.querySelector<HTMLSelectElement>('[data-testid="location-filter"]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="filter-reset"]');
  const roleGrid = document.querySelector<HTMLElement>('[data-testid="roles-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
  const roleCount = document.querySelector<HTMLElement>('[data-testid="role-count"]');

  if (departmentFilter && locationFilter && resetButton && roleGrid && emptyState && roleCount) {
    const roles = Array.from(roleGrid.querySelectorAll<HTMLElement>('[data-testid="role-card"]'))
      .map((card) => ({
        card,
        department: card.dataset.department ?? '',
        location: card.dataset.location ?? '',
      }));

    const updateRoles = (): void => {
      const matchingRoles = new Set(filterJobs(roles, {
        department: departmentFilter.value,
        location: locationFilter.value,
      }));

      for (const role of roles) {
        role.card.hidden = !matchingRoles.has(role);
      }

      emptyState.hidden = matchingRoles.size > 0;
      roleCount.textContent = `Showing ${matchingRoles.size} of ${roles.length} roles`;
    };

    departmentFilter.addEventListener('change', updateRoles);
    locationFilter.addEventListener('change', updateRoles);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      updateRoles();
    });

    emptyState.hidden = true;
  }
</script>
